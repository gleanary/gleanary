# ============================================
# Gleanary — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# Only the three variables marked REQUIRED are needed to run the app —
# feature API keys are best configured in the Settings UI after first login
# (they are stored encrypted in the database).
# ============================================

# --- Database (REQUIRED) ---
# Dev default (relative to the repo root). In Docker, use
# DATABASE_URL=file:/data/db/gleanary.db (compose sets this for you).
DATABASE_URL=file:./data/gleanary.db

# --- Settings Encryption (REQUIRED) ---
# Encrypts API keys stored in the settings table (AES-256-GCM).
# Generate: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=

# --- App Password (REQUIRED) ---
# Bcrypt hash of your app password — used for login and settings confirmation.
# Generate: node -e "require('bcryptjs').hash('your-password', 10).then(console.log)"
# IMPORTANT: wrap the hash in single quotes (or escape every $ as \$) —
# dotenv treats bare $ as a variable reference and corrupts the hash.
# Example: SETTINGS_AUTH_HASH='$2b$10$abc...'
SETTINGS_AUTH_HASH=

# --- Authentication escape hatch ---
# Set to true ONLY when the app is reachable exclusively over a private
# network (Tailscale/VPN/localhost). Disables login entirely.
AUTH_DISABLED=false

# --- Anthropic (AI features: summarize/explain/tag/chat/drafts) ---
ANTHROPIC_API_KEY=

# --- Mistral (PDF OCR) ---
# Required for AI cleanup of PDF articles. Get a key at https://console.mistral.ai
MISTRAL_API_KEY=

# --- AI reformat provider (optional) ---
# Provider for the "Clean up formatting" AI action: mistral (default) or
# anthropic. Best set in the Settings UI; the env var only seeds the default.
# REFORMAT_PROVIDER=mistral

# --- Jina Reader (article fetching) ---
# Optional — without this, Jina's free tier applies (rate-limited).
# Get a key at https://jina.ai
JINA_API_KEY=

# --- Readwise (one-time import) ---
READWISE_API_TOKEN=

# --- Observability (optional) ---
BETTERSTACK_SOURCE_TOKEN=

# --- Application ---
NODE_ENV=production
LOG_LEVEL=info          # debug | info | warn | error
PORT=3000

# --- PDF storage (optional) ---
# Directory where uploaded PDF originals are stored. Defaults to ./data
# (the Docker image sets its own path).
# PDF_DATA_DIR=./data

# --- Inworld TTS (Text-to-Speech) ---
# Optional — if INWORLD_API_KEY is not set, the Listen button won't appear.
# Create an account at https://platform.inworld.ai/ to get a key.
# Set MOCK_TTS=true to use silent audio with word timestamps (free, for dev/debugging).
INWORLD_API_KEY=
INWORLD_DEFAULT_VOICE_EN=Dennis
INWORLD_DEFAULT_VOICE_FR=Marie
INWORLD_TTS_MODEL=inworld-tts-1.5-max
MOCK_TTS=false

# --- TTS Cache ---
# File-system cache for synthesized audio. Avoids re-calling the TTS API.
# Enabled by default. Set to 'false' to disable.
TTS_CACHE_ENABLED=true
TTS_CACHE_DIR=/data/tts-cache
TTS_CACHE_MAX_SIZE_MB=5120          # 5 GB default

# --- Docker compose only (not read by the app) ---
# Host address the plain-HTTP port binds to. The 127.0.0.1 default keeps the
# app local-only; set 0.0.0.0 for LAN/Tailscale access.
# APP_BIND=127.0.0.1
# Domain used by the compose tls profile / Caddy (automatic Let's Encrypt).
DOMAIN=reader.example.com
