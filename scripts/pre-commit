#!/bin/sh
# Pre-commit hook: warn when src/db/schema.ts changes without docs/architecture.md
#
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

if git diff --cached --name-only | grep -q "src/db/schema.ts"; then
  if ! git diff --cached --name-only | grep -q "docs/architecture.md"; then
    echo ""
    echo "⚠️  src/db/schema.ts changed but docs/architecture.md was not updated."
    echo "   Update docs/architecture.md §5 (data model) before committing,"
    echo "   or re-run 'git commit' to confirm this is intentional."
    echo ""
    exit 1
  fi
fi
