# TLS termination for Gleanary — authentication is built into the app itself.
# DOMAIN comes from the compose environment (automatic Let's Encrypt).
# Security headers (CSP, X-Frame-Options, etc.) come from the app (next.config.ts
# headers()); do not add a header block here, or browsers enforce two CSPs.
{$DOMAIN} {
	reverse_proxy app:3000
}
