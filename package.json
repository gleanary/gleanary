{
  "name": "gleanary",
  "version": "0.1.0",
  "description": "Self-hosted, single-user read-it-later and highlight management system — save, read, highlight, review, synthesize.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gleanary/gleanary.git"
  },
  "homepage": "https://github.com/gleanary/gleanary#readme",
  "bugs": {
    "url": "https://github.com/gleanary/gleanary/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "scripts": {
    "predev": "node scripts/migrate.mjs",
    "dev": "next dev",
    "build": "next build",
    "prestart": "node scripts/migrate.mjs",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "approx-string-match": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "defuddle": "^0.19.2",
    "drizzle-orm": "^0.45.2",
    "imapflow": "^1.6.1",
    "isomorphic-dompurify": "^3.19.0",
    "jsdom": "^29.1.1",
    "katex": "^0.18.1",
    "lucide-react": "^1.25.0",
    "mailparser": "^3.9.14",
    "marked": "^18.0.7",
    "next": "16.2.12",
    "node-cron": "^4.6.0",
    "pdfjs-dist": "^6.1.200",
    "pino": "^10.3.1",
    "radix-ui": "^1.6.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-pdf": "^10.4.1",
    "rss-parser": "^3.13.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "turndown": "^7.2.4",
    "zod": "^4.4.3"
  },
  "overrides": {
    "defuddle": {
      "jsdom": "$jsdom"
    },
    "eslint-plugin-react-hooks": "7.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/dompurify": "^3.2.0",
    "@types/jsdom": "^28.0.3",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "msw": "^2.15.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6",
    "vitest": "^4.1.9"
  }
}
