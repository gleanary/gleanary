{
  "name": "gleanary",
  "version": "0.1.0",
  "description": "Self-hosted, single-user read-it-later and highlight management system — save, read, highlight, review, synthesize.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gleanary/gleanary.git"
  },
  "homepage": "https://github.com/gleanary/gleanary#readme",
  "bugs": {
    "url": "https://github.com/gleanary/gleanary/issues"
  },
  "engines": {
    "node": ">=26"
  },
  "private": true,
  "scripts": {
    "predev": "node scripts/migrate.mjs",
    "dev": "next dev",
    "build": "next build",
    "prestart": "node scripts/migrate.mjs",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.0.0",
    "approx-string-match": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "defuddle": "^0.19.5",
    "drizzle-orm": "^0.45.4",
    "imapflow": "^2.5.9",
    "isomorphic-dompurify": "^4.6.0",
    "jsdom": "^30.1.3",
    "katex": "^0.19.0",
    "linkedom": "^0.18.14",
    "lucide-react": "^1.61.0",
    "mailparser": "^3.10.0",
    "marked": "^18.1.1",
    "next": "16.4.2",
    "node-cron": "^4.6.0",
    "pdfjs-dist": "^6.4.299",
    "pino": "^10.4.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-pdf": "^11.0.0",
    "rss-parser": "^3.13.0",
    "server-only": "^0.0.1",
    "turndown": "^7.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/dompurify": "^3.2.0",
    "@types/jsdom": "^30.0.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "msw": "^3.0.3",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "pdfjs-dist": "$pdfjs-dist"
  }
}
