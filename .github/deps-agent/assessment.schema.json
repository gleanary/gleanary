{
  "$comment": "x-maxLength / x-maxItems bound what is STORED (record.mjs clampAssessment clips to them) rather than limiting the answer, so an over-long answer is trimmed instead of failing the assess job. Claude Code validates --json-schema strictly and rejects unknown keywords, so cli.mjs schemaArg strips every x-* key before passing the schema on.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "summary",
    "breakingChangesAffectingUs",
    "securityFixes",
    "adoptableFeatures",
    "ciRead",
    "injectionSuspected",
    "codeReview"
  ],
  "properties": {
    "verdict": { "type": "string", "enum": ["merge", "escalate"] },
    "summary": {
      "type": "string",
      "x-maxLength": 1500,
      "description": "2-4 sentences: what changed and why the verdict"
    },
    "breakingChangesAffectingUs": {
      "type": "array",
      "x-maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["change", "usage"],
        "properties": {
          "change": { "type": "string", "x-maxLength": 400 },
          "usage": { "type": "string", "x-maxLength": 200, "description": "file:line of our code it touches" }
        }
      }
    },
    "securityFixes": { "type": "array", "x-maxItems": 10, "items": { "type": "string", "x-maxLength": 200 } },
    "adoptableFeatures": {
      "type": "array",
      "x-maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "detail"],
        "properties": {
          "title": { "type": "string", "x-maxLength": 100 },
          "detail": { "type": "string", "x-maxLength": 400, "description": "what it is and where we would use it" },
          "link": { "type": "string", "x-maxLength": 200 }
        }
      }
    },
    "ciRead": {
      "type": "string",
      "x-maxLength": 1500,
      "description": "empty when CI is green; else your read of the failure"
    },
    "injectionSuspected": { "type": "boolean" },
    "codeReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "suspicious"],
      "properties": {
        "coverage": {
          "type": "string",
          "enum": ["full", "partial", "none"],
          "description": "how much of the changed published code you actually reviewed"
        },
        "notes": { "type": "string", "x-maxLength": 500 },
        "suspicious": {
          "type": "array",
          "x-maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "finding"],
            "properties": {
              "file": { "type": "string", "x-maxLength": 200 },
              "finding": { "type": "string", "x-maxLength": 400 }
            }
          }
        }
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "recommendation", "options"],
      "properties": {
        "question": { "type": "string", "x-maxLength": 500 },
        "recommendation": { "type": "string", "x-maxLength": 500 },
        "options": { "type": "array", "x-maxItems": 5, "items": { "type": "string", "x-maxLength": 200 } }
      }
    }
  }
}
